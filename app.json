{
  "expo": {
    "name": "PawMeHome",
    "slug": "pawmehome",
    "projectId": "7dc185ec-fe57-4bd6-afc1-dd4f7aa6eb43",
    "owner": "larisau10",
    "scheme": "pawmehome",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./app/utils/images/paw.png",
    "splash": {
      "image": "./app/utils/images/paw.png",
      "resizeMode": "contain", 
    },
    "assetBundlePatterns": ["**/*"],
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.app.PawMeHome",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app requires your location to show you nearby points of interest.",
        "CFBundleURLTypes": [{
          "CFBundleURLSchemes": ["com.googleusercontent.apps.27946158150-avc5iefheitgdejtv5os4i5p09jbhpfp"]
        }]
      },
      
    },
    "android": {
      "package": "com.app.PawMeHome",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": ["ACCESS_FINE_LOCATION"]
    }
  }
}
